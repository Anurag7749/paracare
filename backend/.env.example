# Environment Configuration
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=your_flask_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# PostgreSQL Database Connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://paracare_user:paracare_password@localhost:5432/paracare_db

# CORS Configuration
CORS_ORIGINS=http://localhost:5173

# Device Authentication
# When true (recommended), every ESP32/simulator request must send a valid
# X-Device-Key header matching the device's provisioned API key.
DEVICE_AUTH_REQUIRED=true
